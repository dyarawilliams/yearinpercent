# X / Twitter API credentials (OAuth 1.0a user context)
# Get these from the X Developer Portal: https://developer.x.com/
# Never commit real values — copy this file to .env and fill in locally.
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Optional: app-only bearer (NOT sufficient alone for creating posts)
# X_BEARER_TOKEN=your_bearer_token_here

# Runtime options
DRY_RUN=true
# Overrides config/default.json posting.timezone (IANA name)
# BOT_TIMEZONE=America/New_York
